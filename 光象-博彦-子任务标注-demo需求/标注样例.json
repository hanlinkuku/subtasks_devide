{
  // ========== 顶层元数据 ==========
  "trajectory_id": "episode_000000", // 轨迹唯一编号，用于标识该条数据
  "trajectory_start": 0, // 整个轨迹的起始帧编号（通常从0开始）
  "trajectory_end": 596, // 整个轨迹的结束帧编号（总帧数-1）

  // ========== 顶层任务分段元数据 ==========
  // 将整条轨迹按不同目标动作划分为多个顶层任务段
  // 键为任务ID（字符串），值为该任务的描述信息
  "task_metadata": {
    "6": { // 任务ID，与subtasks中的task_id关联
      "task": "左手打开空调开关@Turn on the air conditioner with your left hand.", // 任务描述，中英文双语，用@分隔
      "task_start": 0, // 该任务在轨迹中的起始帧
      "task_end": 156, // 该任务在轨迹中的结束帧
      "overall_notes": "温控器屏幕已点亮并显示18.0°C，空调开关已成功开启。任务完成。", // 整体执行备注，包括执行结果、失败原因等
      "status": "success" // 任务状态：success（成功）/ fail（失败）/ partial（部分完成）
    }
    // 可继续添加 "1": {...}, "2": {...} 等更多顶层任务
  },

  // ========== 子任务列表 ==========
  // 将顶层任务进一步细化为更小的原子动作单元
  "subtasks": [
    {
      // ---------- 核心标识字段 ----------
      "id": 1, // 子任务序号，从1开始递增，全局唯一
      "name": "用左臂接近温控器。", // 子任务简短名称，概括核心动作
      "notes": "黑色夹爪从画面左侧进入，向温控器移动并靠近，最终停在温控器右侧附近", // 详细的动作描述和观察记录，包括夹爪位置、物体状态变化等

      // ---------- 时间/帧定位字段 ----------
      "start_frame": 38, // 子任务在视频中的起始帧编号
      "end_frame": 70, // 子任务在视频中的结束帧编号
      "start_time": 2.533, // 起始时间（秒），与帧对应，便于快速定位
      "end_time": 4.667, // 结束时间（秒）

      // ---------- 关联与来源字段 ----------
      "boundary_source": "sub_task_vlm", // 标注边界来源：sub_task_vlm（VLM自动标注）/ manual（人工标注）/ algo（算法推理）
      "task_id": "6", // 关联到task_metadata中的哪个顶层任务（字符串，须与上方的键一致）

      // ---------- 目标物体属性 ----------
      // 描述当前子任务操作的主要物体的视觉和物理属性，用于物体识别和模型训练
      "target_object_attribute": {
        "name": "TOSHIBA温控器", // 目标物体名称
        "colors": ["白色", "银色"], // 颜色列表
        "shapes": ["矩形"], // 形状列表
        "materials": ["塑料", "玻璃"], // 材质列表
        "sizes": ["手掌大小"], // 尺寸描述
        "others": ["屏幕显示18.0°C", "带触控按钮"], // 其他属性（如状态、位置、特殊标记等）
        "description": "安装在白墙上的白色方形电子温控面板，品牌为TOSHIBA，带液晶屏和物理按键" // 详细描述该物体在场景中的完整特征
      },

      // ---------- 可选扩展字段 ----------
      // 以下字段根据实际标注需求选择性填写
      "status": "executed", // 执行状态：executed（已执行）/ inferred（推断）/ planned（计划中）
      "confidence": "high", // 置信度：high（高）/ medium（中）/ low（低）
      "completion_inferred": true, // 是否为推断完成（true/false），表示该子任务是否由算法推断而非人工确认
      "skill_id": "reach", // 技能ID，如 reach（接近）/ grasp（抓取）/ rotate（旋转）/ pour（倾倒）等
      "arm_used": "left", // 使用的手臂：left（左臂）/ right（右臂）/ both（双臂）
      "standard_action_text": "左臂接近温控器", // 标准化动作描述，与name类似但更加规范统一
      "extra_notes": "" // 额外备注，用于记录任何补充信息
    }
    // 可继续添加更多子任务，id依次递增
  ]
}